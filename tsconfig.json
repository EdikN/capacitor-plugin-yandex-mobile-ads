{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "module": "es2015",
        "moduleResolution": "node",
        "target": "es2017",
        "declaration": true,
        "outDir": "dist/esm",
        "skipLibCheck": true,
        "lib": ["dom", "es2017"]
    },
    "include": ["src"]
}
